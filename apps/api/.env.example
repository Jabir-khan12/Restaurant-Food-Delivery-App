# ─── Server ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# ─── Client URLs (CORS) ───────────────────────────────────────────────
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ─── MongoDB ───────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/flavour-fleet

# ─── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ───────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ─── Email ─────────────────────────────────────────────────────────────
MAIL_PROVIDER=resend
MAIL_API_KEY=re_xxx
MAIL_FROM=noreply@flavourfleet.com

# ─── Cloudinary ────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Google Maps ───────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─── Rate Limiting ─────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── Misc ──────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
ORDER_AUTO_CANCEL_MINS=5
RIDER_HEARTBEAT_TIMEOUT_SECS=60
