# ─── MongoDB ───────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/flavour-fleet

# ─── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@flavourfleet.com

# ─── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx

# ─── Logging ──────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
